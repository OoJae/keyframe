# Keyframe contracts — copy to contracts/.env (gitignored) or export in your shell. Never commit real values.

# Fork tests (test/fork/*) and local anvil forks. Any Base mainnet RPC works; the suite pins block 52705000.
# e.g. https://mainnet.base.org (public, rate-limited) or https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
BASE_RPC_URL=
# Optional: override the pinned fork block.
# FORK_BLOCK=52705000

# script/Deploy.s.sol (constructor arguments; both are part of the CREATE2 address)
USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
SELLER=
# Optional: where to record the deployment (default deployments/<chainid>.json)
# DEPLOYMENT_OUT=

# Source verification (Etherscan v2 multichain key)
ETHERSCAN_API_KEY=

# script/Smoke.s.sol (local anvil only)
# FACTORY=
# KEYFRAME_SMOKE_LOCAL=1
