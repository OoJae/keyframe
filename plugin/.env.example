# Keyframe plugin configuration (frozen-interfaces.md §9). Set these as portal **Environment variables**
# (Test & configure → Variables & Secrets); they stay editable after the upload lock. None of them is a secret:
# API keys belong in host-scoped brokered headers (Secrets), which the plugin never sees.
# Unset or empty → the embedded default. Invalid → fail closed (money tools refuse; reported by name only).

# Bare https origin of the Keyframe API and x402 resource (no path).
KEYFRAME_API_BASE=https://api.keyframe.studio
# https base of the public ciphertext store: {base}/c/{manifestHash}/manifest.json and {i}.bin, plus stills.
KEYFRAME_FILES_BASE=https://files.keyframe.studio
# Allowlisted escrow factories. vaultImpl MUST be the factory's nonce-1 CREATE address (§2). status: active|refund-only.
KEYFRAME_FACTORIES=[{"address":"0xYourDeployedFactory","vaultImpl":"0xItsVaultImpl","status":"active"}]
# Studio payout wallet(s) and operator hot key(s), comma-separated.
KEYFRAME_SELLERS=0xYourStudioPayoutWallet
KEYFRAME_OPERATORS=0xYourOperatorHotKey
# Up to 3 Base RPCs, cross-checked. Use URLs WITHOUT keys; add an Alchemy key as a brokered
# "Authorization: Bearer <key>" header for base-mainnet.g.alchemy.com instead.
KEYFRAME_RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com
# Ciphertext mirror gateway (path-style /ipfs/{cid}/...), or "off".
KEYFRAME_IPFS_GATEWAY=https://ipfs.filebase.io
# Per-order cap in atomic USDC; clamped to 50000000 (50 USDC).
KEYFRAME_MAX_AMOUNT=50000000
# x402 (default) or direct (plan B if PayBox refuses per-order payees; ADR-011).
KEYFRAME_PRIMARY_RAIL=x402
# direct-first (default: delegated wallet with ETH pays by direct transfer) or x402-autoundelegate.
KEYFRAME_7702_POLICY=direct-first
# 1 pauses new quotes and payments; status/verify/refund/review/orders keep working.
KEYFRAME_MAINTENANCE=0
