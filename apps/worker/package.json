{
  "name": "@keyframe/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Keyframe render worker: HyperFrames + ffmpeg. Claims jobs from the API, renders still/preview/master, holds no keys.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/cli.ts serve",
    "render": "node src/cli.ts render",
    "check:templates": "node src/cli.ts check --all --extremes",
    "preflight": "node src/cli.ts preflight",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ./src/register.ts --test \"test/*.test.ts\"",
    "test:integration": "node --import ./src/register.ts --test --test-timeout=900000 \"test/integration/*.test.ts\"",
    "schema": "node src/cli.ts schema --write",
    "sync:protocol": "node ../../scripts/sync-protocol.mjs --target src/protocol",
    "sync:protocol:check": "node ../../scripts/sync-protocol.mjs --target src/protocol --check"
  },
  "dependencies": {
    "hyperframes": "0.8.140",
    "pino": "10.4.0",
    "viem": "2.51.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "gsap": "3.15.0",
    "typescript": "5.9.3"
  }
}
