# Keyframe render worker. Copy to .env (git-ignored) and fill in. Only API_BASE and WORKER_TOKEN are required for
# `serve`; the local `render`/`check` commands need neither. Every value is validated at startup.

# --- API (required for `serve`) ---
# https only (plain http is accepted for a loopback host).
API_BASE=https://api.example.com
# Bearer token for /internal/*, the same value as the API's WORKER_TOKEN secret, at least 32 characters. Generate: openssl rand -base64 48
WORKER_TOKEN=
# Defaults to the hostname. Shown to the API in every call.
WORKER_ID=render-vps-1

# --- Capacity ---
# Concurrent jobs. Each instant_render job renders its quote-time still first, then the master.
RENDER_LANES=1
# hyperframes render --workers (each is a Chrome, about 256 MB). An integer 1-9, or auto.
RENDER_WORKERS=3

# --- Paths ---
# Defaults: ../../templates relative to apps/worker, and $TMPDIR/keyframe-worker.
# TEMPLATES_DIR=/app/templates
# WORK_DIR=/work
# 1 keeps job directories after completion (debugging only: they contain buyer inputs).
KEEP_JOBS=0

# --- Encoding ---
RENDER_CRF=20
PREVIEW_CRF=30
# Browser GPU for snapshots and renders alike: off | auto | on. off (SwiftShader) makes re-renders byte-identical;
# hardware capture is not bit-exact between runs.
BROWSER_GPU=off
# Below this SSIM, the master's hero frame is reported as not matching the approved still.
HERO_SSIM_MIN=0.97

# --- Timeouts (ms) ---
STILL_TIMEOUT_MS=45000
# Floor for the render stage; the template's perf.renderBudgetS x 4 applies when larger.
RENDER_TIMEOUT_MS=180000
FFMPEG_TIMEOUT_MS=120000
HTTP_TIMEOUT_MS=15000
UPLOAD_TIMEOUT_MS=120000
DRAIN_TIMEOUT_MS=120000
POLL_INTERVAL_MS=2000
# Lease renewal + progress report per job (the API lease is 600 s).
HEARTBEAT_INTERVAL_MS=15000

# --- Health endpoint (GET /healthz, /readyz) ---
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8790

# --- Tools ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
LOG_LEVEL=info
