{
  "name": "@keyframe/api",
  "version": "1.0.0",
  "description": "Keyframe x402 API on Cloudflare Workers: quotes, deterministic 402, verify-then-settle via the escrow factory, relayer, keeper, render-worker API.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm run typecheck:worker",
    "test": "vitest run",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "smoke": "node scripts/smoke-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply keyframe --local",
    "db:migrate:remote": "wrangler d1 migrations apply keyframe --remote",
    "typecheck:worker": "tsc -p ../../packages/protocol/tsconfig.src.json --noEmit false --declaration --emitDeclarationOnly --outDir .types/protocol && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@keyframe/protocol": "workspace:*",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "hono": "4.13.13",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.147.0"
  }
}
