{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^_?[a-z][a-z0-9_]{1,39}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "format": {
      "type": "string",
      "enum": [
        "launch_sting",
        "countdown",
        "portfolio_pulse",
        "kinetic_post",
        "chart_moment",
        "studio_sting",
        "studio_spot",
        "catalog"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "production",
        "reference",
        "awaiting-design",
        "kit"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "styles": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
      }
    },
    "aspects": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "9:16",
          "1:1",
          "16:9"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "durations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 120
      }
    },
    "heroTime": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "perf": {
      "type": "object",
      "properties": {
        "renderBudgetS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stillBudgetS": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "renderBudgetS",
        "stillBudgetS"
      ],
      "additionalProperties": false
    },
    "variables": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "string"
              },
              "default": {
                "type": "string"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "pattern": {
                "type": "string"
              },
              "json": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "default",
              "maxLength"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "number"
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "integer": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "default",
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "color"
              },
              "default": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "enum"
              },
              "default": {
                "type": "string"
              },
              "options": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "label",
              "type",
              "default",
              "options"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "overlay": {
      "type": "object",
      "properties": {
        "opacity": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.6
        }
      },
      "required": [
        "opacity"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "format",
    "status",
    "title",
    "styles",
    "aspects",
    "fps",
    "durations",
    "heroTime",
    "perf",
    "variables"
  ],
  "additionalProperties": false
}
